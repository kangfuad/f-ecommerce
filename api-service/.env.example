# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
APP_NAME=e-punyasewa-api
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epunyasewa_db?schema=public"

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_PRODUCTS=600000
CACHE_TTL_REGIONS=86400000

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-for-epunyasewa-platform-2026!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-epunyasewa-2026!
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# File Storage (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads

# AWS S3 / MinIO (Optional if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=e-punyasewa-storage
AWS_S3_ENDPOINT=
