              "mode": "raw",
              "raw": "{\n  \"reason\": \"Unit sedang dalam jadwal perawatan sensor berkala di service center resmi.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/provider/orders/{{order_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["provider", "orders", "{{order_id}}", "reject"]
            }
          }
        },
        {
          "name": "4.4 Upload Berkas Perjanjian TTD & Bukti Kuitansi",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "signedAgreementFile",
                  "type": "file",
                  "src": [],
                  "description": "File PDF / Foto Surat Perjanjian Sewa TTD (SP-EPS)"
                },
                {
                  "key": "paymentBillFile",
                  "type": "file",
                  "src": [],
                  "description": "Foto / File Kuitansi Pelunasan Sewa"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/provider/orders/{{order_id}}/upload-documents",
              "host": ["{{base_url}}"],
              "path": ["provider", "orders", "{{order_id}}", "upload-documents"]
            }
          }
        },
        {
          "name": "4.5 Selesaikan Masa Sewa (Complete Rental)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/provider/orders/{{order_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["provider", "orders", "{{order_id}}", "complete"]
            }
          }
        },
        {
          "name": "4.6 Penyedia Memberikan Review Reputasi Penyewa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Penyewa sangat amanah, tepat waktu saat jadwal temu, dan unit kembali dalam kondisi bersih prima.\",\n  \"badges\": [\"Pengembalian Tepat Waktu\", \"Unit Terawat Sangat Baik\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/provider/orders/{{order_id}}/review-tenant",
              "host": ["{{base_url}}"],
              "path": ["provider", "orders", "{{order_id}}", "review-tenant"]
            }
