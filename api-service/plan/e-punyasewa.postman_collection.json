    {
      "name": "3. Modul Reservasi & Pesanan Penyewa",
      "item": [
        {
          "name": "3.1 Submit Booking Sewa Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.orderId) {",
                  "    pm.environment.set('order_id', jsonData.data.orderId);",
                  "    console.log('Created Order ID:', jsonData.data.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"eps_drone_01\",\n      \"quantity\": 1,\n      \"startDate\": \"2026-08-28\",\n      \"endDate\": \"2026-08-31\",\n      \"rentalDays\": 3,\n      \"dailyRate\": 550000,\n      \"depositRate\": 2500000,\n      \"totalAmount\": 1650000\n    }\n  ],\n  \"meetup\": {\n    \"locationType\": \"PROVIDER_HUB\",\n    \"locationName\": \"Hub Gandaria Jakarta Selatan\",\n    \"locationAddress\": \"Jl. Gandaria 1 No. 12, Kebayoran Baru, Jakarta Selatan\",\n    \"scheduleDate\": \"2026-08-28\",\n    \"scheduleTime\": \"09:00 WIB\",\n    \"notes\": \"Uji coba flight control dan tanda tangan berkas di tempat.\"\n  },\n  \"customer\": {\n    \"fullName\": \"Budi Santoso\",\n    \"phone\": \"081399887766\",\n    \"email\": \"budi.santoso@example.com\",\n    \"deliveryAddress\": \"Jl. Ir. H. Juanda No. 88, Dago\"\n  },\n  \"bookingNotes\": \"Digunakan untuk pengambilan shot video komersial hotel resort.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": ["{{base_url}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "3.2 Riwayat Pesanan Saya (My Orders)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/my-orders?status=ALL",
              "host": ["{{base_url}}"],
              "path": ["orders", "my-orders"],
              "query": [
                { "key": "status", "value": "ALL", "description": "ALL | PENDING | ACTIVE | COMPLETED | REJECTED" }
              ]
            }
          }
        },
        {
          "name": "3.3 Perpanjang Durasi Sewa (+N Hari)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalDays\": 2,\n  \"notes\": \"Jadwal syuting komersial mundur 2 hari karena kendala cuaca.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/extend",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "extend"]
            }
          }
        },
        {
          "name": "3.4 Penyewa Memberi Ulasan & Rating",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Unit drone sangat prima, baterai full, dan pelayanan ramah!\",\n  \"tags\": [\"Unit Bersih\", \"Pelayanan Cepat\", \"Sangat Direkomendasikan\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/review",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "review"]
            }
          }
        }
      ]
